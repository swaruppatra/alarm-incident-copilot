ALARM_API_BASE_URL=http://alarm-api:8000
ALARM_API_TOKEN=replace-me
ALARM_API_TIMEOUT_SECONDS=5.0
ALARM_API_MAX_RETRIES=3
DB_PATH=./var/alarm_simulator.sqlite3
MCP_SERVER_URL=http://alarm-mcp:9000
TICKETING_MCP_SERVER_URL=http://ticketing-mcp:9100
# stdio for local dev tools (MCP Inspector, Claude Desktop); streamable-http
# is what docker-compose's alarm-mcp service overrides this to.
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=9000
LLM_PROVIDER=replace-me
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini
VECTOR_STORE_URL=http://vector-store:6333
# Only needed against a real hosted/authenticated Qdrant cluster; leave unset for local dev.
QDRANT_API_KEY=replace-me
QDRANT_COLLECTION_NAME=alarm_incident_docs
EMBEDDING_MODEL=text-embedding-3-small
DOCUMENT_PATH=./rag/documents
TICKETING_API_URL=http://ticketing-api:8100
TICKETING_API_TOKEN=replace-me
TICKETING_API_TIMEOUT_SECONDS=5.0
TICKETING_API_MAX_RETRIES=3
TICKETING_DB_PATH=./var/ticketing.sqlite3
