# apps/frontend-specific settings. Loaded from the repo root .env (see
# apps/frontend/config.py) alongside every other service's settings -- copy
# these into the root .env, this file itself is not read directly.

# Base URL of the copilot-backend FastAPI service.
COPILOT_BACKEND_URL=http://localhost:8080

# Seconds to wait for a /chat or /confirm response before showing an error.
COPILOT_REQUEST_TIMEOUT_SECONDS=60.0

# Port the Gradio app itself listens on.
COPILOT_FRONTEND_PORT=3000

# Shared with apps.backend.audit.DB_PATH -- the Ops tab reads this file
# directly. Resolves correctly by default both for local dev (repo-root
# relative) and in Docker (docker-compose.yml mounts ./var into both
# copilot-backend and copilot-frontend at /app/var).
AUDIT_DB_PATH=./var/audit_trail.sqlite3
